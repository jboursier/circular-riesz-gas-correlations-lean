/-!
# Theorem 4 (Quantitative convergence of labelled gaps): the definitions

The definitions in this file specify the finite and limiting laws, Palm regularity, labelled gap
blocks, Lipschitz observables, their coordinate norms and the rate, and are shared by the
challenge and solution.

The definitions below are copied without change, in dependency order, from the files
`Riesz2/Frozen/*.lean` of the library and from `Riesz1/Frozen/*.lean` of the companion
library, inside the namespace `Riesz2Audit.QuantitativeConvergence`. For example, `Riesz2.gibbsMeasure` of the
library is `Riesz2Audit.QuantitativeConvergence.Riesz2.gibbsMeasure` here. This file imports Mathlib only.
-/

@[expose] public section

namespace Riesz2Audit.QuantitativeConvergence

noncomputable section

open MeasureTheory Filter
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz1

/-- Ordered lift domain in a fundamental region. -/
def orderedDomain (N : ℕ+) : Set (Fin (N : ℕ) → ℝ) :=
  {x | StrictMono x ∧ 0 ≤ x ⟨0, N.pos⟩ ∧ x ⟨0, N.pos⟩ < 1 ∧
    ∀ i, x i < x ⟨0, N.pos⟩ + 1}


end Riesz1

end


noncomputable section

open MeasureTheory Filter
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz1

/-- Configurations, with unique first lift in [0,1). -/
@[reducible] def Configuration (N : ℕ+) := orderedDomain N


end Riesz1

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- Lipschitz functions G : ℝᴷ → ℝ as in Theorem 4. Lean uses the sup norm on the finite
coordinate space. It gives the same class of functions as the Euclidean norm. -/
@[reducible] def BlockObservable (K : ℕ+) :=
  {G : (Fin (K : ℕ) → ℝ) → ℝ // ∃ L : ℝ≥0, LipschitzWith L G}

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The space Conf(ℝ) of simple locally finite configurations from Subsection 1.5, represented
as sets of atoms. It includes the empty configuration. -/
@[reducible] def LineConfiguration :=
  {A : Set ℝ // ∀ a b : ℝ, (A ∩ Icc a b).Finite}

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The count N_B(𝓒) = #(𝓒 ∩ B) from Subsection 1.5, with values in ℝ≥0∞. Counts on unbounded
sets may be infinite. -/
def count (C : LineConfiguration) (B : Set ℝ) : ℝ≥0∞ := (C.val ∩ B).encard

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The σ-algebra on Conf(ℝ) generated by the counts N_B for bounded Borel sets B, as in
Subsection 1.5. -/
@[reducible] def configurationMeasurableSpace : MeasurableSpace LineConfiguration :=
  ⨆ (B : Set ℝ) (_ : MeasurableSet B) (_ : Bornology.IsBounded B),
    MeasurableSpace.comap (fun C : LineConfiguration => count C B) inferInstance

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- A probability law on Conf(ℝ), the simple locally finite configurations of Subsection 1.5. -/
@[reducible] def PointProcess :=
  letI := configurationMeasurableSpace
  ProbabilityMeasure LineConfiguration

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The translated configuration 𝓒−t. This sign convention roots a particle at t at the origin
in the Palm construction of Subsection 6.3. -/
def translateConfiguration (t : ℝ) (C : LineConfiguration) : LineConfiguration :=
  ⟨{x | x + t ∈ C.val}, fun a b =>
    ((C.property (a + t) (b + t)).image (fun x => x - t)).subset (by
      rintro x ⟨hx, ha, hb⟩
      exact ⟨x + t, ⟨hx, by constructor <;> linarith⟩, by ring⟩)⟩

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The finite measure ∑_{x ∈ 𝓒 ∩ [0,1)} δ_{𝓒−x}, which roots the configuration at each particle
in [0,1). It is used to construct the Palm law Riesz_{s,β}^0 of Subsection 1.5. -/
def palmKernel (C : LineConfiguration) :
    letI := configurationMeasurableSpace
    Measure LineConfiguration :=
  letI := configurationMeasurableSpace
  Measure.sum (fun x : {x : ℝ // x ∈ C.val ∩ Ico (0 : ℝ) 1} =>
    Measure.dirac (translateConfiguration x.val C))

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The mean rooted counting measure E_P[∑_{x ∈ 𝓒 ∩ [0,1)} δ_{𝓒−x}]. For a stationary process of
intensity one this is its Palm probability law. See Subsection 1.5 and the Palm construction
in Subsection 6.3. -/
def palmMeasure (P : PointProcess) :
    letI := configurationMeasurableSpace
    Measure LineConfiguration :=
  letI := configurationMeasurableSpace
  (P : Measure LineConfiguration).bind palmKernel

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The set of configurations containing zero and unbounded in both directions, used for the
Palm law and enumeration in Subsection 1.5. -/
def rootedConfigurations : Set LineConfiguration :=
  {C | 0 ∈ C.val ∧ (∀ r : ℝ, ∃ x ∈ C.val, r < x) ∧
    (∀ r : ℝ, ∃ x ∈ C.val, x < r)}

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- Configurations rooted at zero and unbounded in both directions. This is the carrier for the
two-sided Palm enumeration (z_i)_{i ∈ ℤ} of Subsection 1.5. -/
@[reducible] def RootedConfiguration := rootedConfigurations

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The increasing enumeration (z_i)_{i ∈ ℤ} with z₀ = 0, specified by count thresholds. Local
finiteness and unboundedness in both directions make the right-tail minima and left-tail
maxima finite and attained. See Subsection 1.5. -/
def rootedPoint (C : RootedConfiguration) (i : ℤ) : ℝ :=
  if i = 0 then 0 else if 0 < i then
    sInf {x : ℝ | x ∈ C.val.val ∧ 0 < x ∧
      (i.toNat : ℝ≥0∞) ≤ count C.val (Ioc 0 x)}
  else sSup {x : ℝ | x ∈ C.val.val ∧ x < 0 ∧
      ((-i).toNat : ℝ≥0∞) ≤ count C.val (Ico x 0)}

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The gap z_{i+1}−z_i in the two-sided Palm enumeration with z₀ = 0. See Subsection 1.5 and
Proposition 1.2. -/
def rootedGap (C : RootedConfiguration) (i : ℤ) : ℝ :=
  rootedPoint C (i + 1) - rootedPoint C i

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The pullback of the Palm law to configurations rooted at zero and unbounded in both
directions. The convergence statement establishes full mass of this carrier and
normalization of the pullback. See Subsection 1.5 and the proof of Theorem 3 in Subsection
6.3. -/
def rootedPalmMeasure (P : PointProcess) :
    letI := configurationMeasurableSpace
    Measure RootedConfiguration :=
  letI := configurationMeasurableSpace
  (palmMeasure P).comap Subtype.val

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The Palm law is a probability supported on configurations rooted at zero and unbounded in
both directions. Its gaps are invariant under shifts of the labels, integrable and of mean
one. These properties hold for the limit in the proof of Theorem 3 in Subsection 6.3. -/
def PalmRegular (P : PointProcess) : Prop :=
  letI := configurationMeasurableSpace
  MeasurableSet rootedConfigurations ∧ palmMeasure P rootedConfigurations = 1 ∧
    IsProbabilityMeasure (rootedPalmMeasure P) ∧
    IsProbabilityMeasure (palmMeasure P) ∧ palmMeasure P rootedConfigurationsᶜ = 0 ∧
    (rootedPalmMeasure P).map (fun C i => rootedGap C (i + 1)) =
      (rootedPalmMeasure P).map rootedGap ∧
    ∀ i : ℤ, Integrable (fun C => rootedGap C i) (rootedPalmMeasure P) ∧
      (∫ C, rootedGap C i ∂rootedPalmMeasure P) = 1

end Riesz2

end


