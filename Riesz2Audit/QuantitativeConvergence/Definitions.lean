open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The parameters (β,s) with β > 0, s > 0 and s ≠ 1, covering both regimes of Subsection 1.1. -/
@[reducible] def Parameters := {p : ℝ × ℝ // 0 < p.1 ∧ 0 < p.2 ∧ p.2 ≠ 1}

end Riesz2

end


noncomputable section

open MeasureTheory Filter
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz1

/-- Particle count n+1, for sequences starting at zero. -/
def particleNumber (n : ℕ) : ℕ+ := ⟨n + 1, Nat.succ_pos n⟩


end Riesz1

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The restriction 𝓒|_B of a simple configuration to a set B. In Theorem 3, B is the bounded
window [−R,R]. -/
def restrictConfiguration (B : Set ℝ) (C : LineConfiguration) : LineConfiguration :=
  ⟨C.val ∩ B, fun a b => (C.property a b).subset (by
    intro x hx
    exact ⟨hx.1.1, hx.2⟩)⟩

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The supremum of |μ(A)−ν(A)| over measurable events A, for finite measures. For probability
densities it is half the L¹ distance. This is the distance used in Theorem 3. -/
def totalVariation {Ω : Type*} [MeasurableSpace Ω] (μ ν : Measure Ω)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν] : ℝ≥0∞ :=
  ⨆ A : {A : Set Ω // MeasurableSet A},
    (μ A.val - ν A.val) + (ν A.val - μ A.val)

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- Convergence of π_R#Q_{N,β} to π_R#P in total variation for every R > 0, as in Theorem 3. All
laws are probabilities. Positive particle numbers are indexed by n + 1. -/
def LocalConverges (laws : ℕ+ → @Measure LineConfiguration configurationMeasurableSpace) (P : PointProcess) : Prop :=
  letI := configurationMeasurableSpace
  ∃ h : ∀ N, IsProbabilityMeasure (laws N),
    letI (N : ℕ+) : IsProbabilityMeasure (laws N) := h N
    ∀ R : ℝ, 0 < R →
    Tendsto (fun n : ℕ => totalVariation
      ((laws (Riesz1.particleNumber n)).map (restrictConfiguration (Icc (-R) R)))
      ((P : Measure LineConfiguration).map (restrictConfiguration (Icc (-R) R))))
      atTop (𝓝 0)

end Riesz2

end


