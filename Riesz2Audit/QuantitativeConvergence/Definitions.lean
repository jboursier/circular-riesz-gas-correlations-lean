noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The configuration 𝓒_N obtained by centering at a circle point a, retaining particles whose
centered lift has absolute value less than 1/4, and multiplying positions by N. This is the
microscopic configuration of Subsection 1.4. Distinct particles give distinct atoms. -/
def microscopicConfiguration {N : ℕ+} (a : UnitAddCircle)
    (X : Riesz1.Configuration N) : LineConfiguration :=
  let r : Fin (N : ℕ) → ℝ := fun i =>
    Riesz1.centralRep Riesz1.unitLength ((X.val i : UnitAddCircle) - a)
  ⟨{x | ∃ i, |r i| < 1 / 4 ∧ x = (N : ℝ) * r i}, fun b c =>
    (Set.finite_range (fun i => (N : ℝ) * r i)).subset (by
      rintro x ⟨⟨i, _, rfl⟩, _⟩
      exact ⟨i, rfl⟩)⟩

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The law Q_{N,β} of the microscopic configuration about the fixed spatial origin, as in
equation (1.7). -/
def microscopicLaw (p : Parameters) (N : ℕ+) :
    letI := configurationMeasurableSpace
    Measure LineConfiguration :=
  letI := configurationMeasurableSpace
  (gibbsMeasure p N).map (microscopicConfiguration 0)

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The assertion that there exists exactly one point process P to which Q_{N,β} converges in
local total variation. This specifies the limit in Theorem 3. -/
def UniqueRieszLimit (p : Parameters) : Prop :=
  ∃! P : PointProcess, LocalConverges (microscopicLaw p) P

end Riesz2

end


noncomputable section

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators BoundedContinuousFunction

namespace Riesz2

/-- The least Lipschitz constant of G along coordinate j, encoding ‖∂ⱼG‖∞ in Theorem 4. For
Lipschitz G this equals the Lebesgue essential supremum of its weak partial derivative on
ℝᴷ. -/
def coordinateDerivativeNorm {K : ℕ+} (G : BlockObservable K) (j : Fin (K : ℕ)) : ℝ≥0 :=
  sInf {L : ℝ≥0 | ∀ (x : Fin (K : ℕ) → ℝ) (t : ℝ),
    |G.val (Function.update x j t) - G.val x| ≤ (L : ℝ) * |t - x j|}

end Riesz2

end


